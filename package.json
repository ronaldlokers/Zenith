{
  "name": "zenith",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint --max-warnings=0",
    "preview": "npm run build && vite preview",
    "deploy": "npm run build && wrangler deploy",
    "cf-typegen": "wrangler types",
    "migrate:remote": "node scripts/check-database-id.mjs && wrangler d1 migrations apply zenith --remote",
    "test": "vitest run --project=workers --project=components --project=node",
    "e2e": "npm run build && vitest run --project=e2e",
    "coverage": "vitest run --project=components --coverage",
    "test:components": "vitest run --project components",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "@block65/webcrypto-web-push": "^1.0.2",
    "better-auth": "^1.7.3",
    "hono": "^4.13.7",
    "i18next": "^26.4.2",
    "i18next-browser-languagedetector": "^8.2.1",
    "jspdf": "^4.2.1",
    "postal-mime": "^3.0.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-i18next": "^17.0.13",
    "react-router-dom": "^7.18.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.54.6",
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@storybook/addon-a11y": "^10.6.0",
    "@storybook/addon-docs": "^10.6.0",
    "@storybook/react-vite": "^10.6.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^4.1.10",
    "axe-core": "^4.13.0",
    "jsdom": "^25.0.1",
    "oxlint": "^1.82.0",
    "playwright": "^1.63.0",
    "storybook": "^10.5.2",
    "typescript": "~6.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.10",
    "wrangler": "^4.111.0"
  }
}
